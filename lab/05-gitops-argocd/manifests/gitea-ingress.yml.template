apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gitea
  namespace: gitops-lab
  annotations:
    # Browser uses /gitea/* (ROOT_URL); Gitea serves at /* — strip before the backend.
    traefik.ingress.kubernetes.io/router.middlewares: gitops-lab-gitea-stripprefix@kubernetescrd
spec:
  rules:
    - host: ${K3SLAB_INGRESS_HOST}
      http:
        paths:
          - path: /gitea
            pathType: Prefix
            backend:
              service:
                name: gitea
                port:
                  number: 3000
